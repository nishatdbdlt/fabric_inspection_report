<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fabric_inspection" model="ir.module.category">
        <field name="name">Fabric Inspection</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_fabric_inspection_user" model="res.groups">
        <field name="name">Inspector / User</field>
        <field name="category_id" ref="module_category_fabric_inspection"/>
    </record>

    <record id="group_fabric_inspection_manager" model="res.groups">
        <field name="name">Quality Manager</field>
        <field name="category_id" ref="module_category_fabric_inspection"/>
        <field name="implied_ids" eval="[(4, ref('group_fabric_inspection_user'))]"/>
    </record>
</odoo>
